# ==============================================================================
# WISDOM ACADEMY · PLANTILLA DE VARIABLES DE ENTORNO
#
# Copia este archivo a `.env` y sustituye cada valor CAMBIAR_* por uno propio.
# NUNCA confirmes `.env`, respaldos con datos reales, contraseñas, tokens ni
# claves privadas en Git. Genera secretos con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NÚCLEO DE LA PLATAFORMA (NEXT.JS + SQLITE)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Ruta de la base de datos. En producción usa una ruta persistente y respaldada.
# Vercel serverless NO ofrece disco persistente: no uses SQLite allí en producción.
WISDOM_DB_PATH=.data/wisdom.db

# Solo para demostraciones efímeras. Nunca en producción: los datos se pierden.
WISDOM_ALLOW_EPHEMERAL_DB=0

# Directorio de respaldos verificados (npm run db:backup).
WISDOM_BACKUP_DIR=.data/backups

# Cuenta creadora. El rol platform_owner solo se crea con `npm run provision:owner`.
PLATFORM_OWNER_EMAIL=owner@example.com

# Archivo de entrega de la contraseña inicial (fuera del repositorio recomendado).
# Si se omite, se usa ~/.wisdom-academy/owner-initial-credential.txt
OWNER_CREDENTIALS_FILE=

# Pepper para hashes HMAC de códigos de regalo, descuentos e invitaciones.
# En producción es OBLIGATORIO definir uno estable y secreto.
CODE_HASH_PEPPER=CAMBIAR_PEPPER_ALEATORIO_DE_32_BYTES

# Sal para anonimizar IP en límites de frecuencia. Cámbiala en producción.
WISDOM_RATE_LIMIT_SALT=CAMBIAR_SAL_ALEATORIA

# ------------------------------------------------------------------------------
# 2. AUTENTICACIÓN CON GOOGLE (VERIFICACIÓN DE ID TOKEN EN EL SERVIDOR)
# ------------------------------------------------------------------------------
# El mismo Client ID se usa en el navegador y en el servidor. Configura en Google
# Cloud Console los orígenes autorizados (por ejemplo http://localhost:3000).
# Sin este valor, el acceso con Google queda deshabilitado y se informa en /login.
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 3. PAYPAL (SANDBOX POR DEFECTO)
# ------------------------------------------------------------------------------
# PAYPAL_MODE=sandbox | live. No se realizan cobros reales en sandbox.
PAYPAL_MODE=sandbox
# Client ID y Client Secret de la REST API app del entorno correspondiente.
# El Client Secret es SOLO de servidor: nunca lo prefijes con NEXT_PUBLIC_.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# ID del webhook del MISMO entorno (sandbox o live). Es obligatorio para
# aceptar notificaciones: sin él, el endpoint rechaza todos los eventos.
PAYPAL_WEBHOOK_ID=
# Moneda de cobro. Los precios se guardan en centavos de esta moneda.
# La plataforma actual usa USD de extremo a extremo; no cambies este valor
# sin actualizar los precios de los productos y probar la captura.
PAYPAL_CURRENCY=USD
# Solo para pruebas locales contra un servidor simulado. Déjalo vacío en
# producción: un valor distinto de la URL oficial desvía las llamadas a PayPal.
PAYPAL_API_BASE_URL=

# ------------------------------------------------------------------------------
# 4. MOODLE / MARIADB (INTEGRACIÓN LMS EXISTENTE)
# ------------------------------------------------------------------------------
MARIADB_ROOT_PASSWORD=CAMBIAR_EN_PRODUCCION
MARIADB_DATABASE=wisdom_moodle_db
MARIADB_USER=wisdom_user
MARIADB_PASSWORD=CAMBIAR_EN_PRODUCCION

MOODLE_PORT_HTTP=8080
MOODLE_PORT_HTTPS=8443
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=CAMBIAR_EN_PRODUCCION
MOODLE_ADMIN_EMAIL=admin@wisdomacademy.edu.ec
MOODLE_REST_TOKEN=CAMBIAR_TOKEN_MOODLE
NEXT_PUBLIC_MOODLE_URL=http://localhost:8080
# Solo para desarrollo/pruebas explícitas. Nunca simula éxito en producción.
MOODLE_MOCK=0

# ------------------------------------------------------------------------------
# 5. GOOGLE DRIVE / CALENDAR (SINCRONIZACIÓN CURRICULAR)
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_CLIENT_ID=
GOOGLE_DRIVE_CLIENT_SECRET=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCAMBIAR\n-----END PRIVATE KEY-----\n"
# Carpeta privada FUERA del arbol del curso para originales de examenes con respuestas.
GOOGLE_DRIVE_PRIVATE_ADMIN_FOLDER_ID=
# Carpeta raiz de expedientes privados para copias de informes de calificacion.
GOOGLE_DRIVE_STUDENT_REPORTS_FOLDER_ID=

# ------------------------------------------------------------------------------
# 6. PROVEEDORES DE IA (OPENMAIC)
# ------------------------------------------------------------------------------
GOOGLE_GEMINI_API_KEY=
OPENROUTER_FREE_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# ------------------------------------------------------------------------------
# 7. VIDEOLLAMADAS
# ------------------------------------------------------------------------------
JITSI_DOMAIN=meet.jit.si
BBB_SERVER_URL=
BBB_SHARED_SECRET=
GOOGLE_MEET_DEFAULT_URL=
ZOOM_DEFAULT_JOIN_URL=
MS_TEAMS_DEFAULT_URL=

# ------------------------------------------------------------------------------
# 8. RECURSOS EDUCATIVOS AUDIOVISUALES
# ------------------------------------------------------------------------------
# Clave SOLO de servidor. Nunca uses el prefijo NEXT_PUBLIC_.
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=EC
EDUCATIONAL_VIDEO_CATALOG_PATH=
EDUCATIONAL_RESOURCES_DATA_DIR=.data/educational-resources
EDUCATIONAL_RESOURCES_PERSIST=true
EDUCATIONAL_RESOURCE_RATE_LIMIT_SALT=CAMBIAR_SAL_ALEATORIA
# Token del panel de revisión docente (/admin/recursos). Solo servidor.
EDUCATIONAL_RESOURCES_ADMIN_TOKEN=

# ------------------------------------------------------------------------------
# 9. CORREO TRANSACCIONAL (REGISTRO, VERIFICACIÓN Y RECUPERACIÓN)
# ------------------------------------------------------------------------------
# Resend se usa mediante API HTTP; la clave es solo de servidor.
RESEND_API_KEY=
# Remitente verificado en el proveedor, por ejemplo:
# EMAIL_FROM="Wisdom Academy <no-reply@tudominio.com>"
EMAIL_FROM=
EMAIL_REPLY_TO=

# ------------------------------------------------------------------------------
# 10. PRUEBAS E2E (NUNCA ACTIVAR EN PRODUCCIÓN)
# ------------------------------------------------------------------------------
# El servidor de Playwright establece WISDOM_E2E=1 y siembra fixtures aisladas.
# No definas estas variables en un despliegue real.
WISDOM_E2E=0
WISDOM_E2E_PASSWORD=CAMBIAR_SOLO_PRUEBAS
WISDOM_E2E_ADMIN_PASSWORD=CAMBIAR_SOLO_PRUEBAS
# Solo para probar una compilación de producción por HTTP local con E2E.
WISDOM_ALLOW_INSECURE_COOKIE=0
