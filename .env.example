# ==============================================================================
# WISDOM ACADEMY · PLANTILLA DE VARIABLES DE ENTORNO
#
# Arquitectura Serverless de Alta Disponibilidad:
# - Frontend & API: Vercel Serverless (Next.js 15)
# - Motor Transaccional: Turso (libSQL Cloud SQLite)
# - Bóveda Documental y Académica: Google Drive API v3
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. NÚCLEO DE LA PLATAFORMA & PERSISTENCIA (TURSO / SQLITE)
# ------------------------------------------------------------------------------
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# TURSO CLOUD (Obligatorio en producción / Vercel Serverless)
# Obtén estos valores con: turso db create wisdom-db && turso db tokens create wisdom-db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# SQLITE LOCAL (Fallback para desarrollo local y ejecución de tests automatizados)
WISDOM_DB_PATH=.data/wisdom.db

# Directorio de respaldos verificados locales (npm run db:backup)
WISDOM_BACKUP_DIR=.data/backups

# Cuenta creadora. El rol platform_owner se inicializa con `npm run provision:owner`.
PLATFORM_OWNER_EMAIL=owner@example.com

# Archivo de entrega de la contraseña inicial (fuera del repositorio recomendado).
# Si se omite, se usa ~/.wisdom-academy/owner-initial-credential.txt
OWNER_CREDENTIALS_FILE=

# Pepper para hashes HMAC de códigos de regalo, descuentos e invitaciones.
# En producción es OBLIGATORIO definir uno estable y secreto de 32 bytes mínimo.
CODE_HASH_PEPPER=CAMBIAR_PEPPER_ALEATORIO_DE_32_BYTES

# Sal para anonimizar IP en límites de frecuencia. Cámbiala en producción.
WISDOM_RATE_LIMIT_SALT=CAMBIAR_SAL_ALEATORIA

# Secreto para proteger los Vercel Cron Jobs (/api/cron/drive-sync-backup).
CRON_SECRET=CAMBIAR_CRON_SECRET_SEGURO

# ------------------------------------------------------------------------------
# 2. AUTENTICACIÓN CON GOOGLE (OAUTH / IDENTITY)
# ------------------------------------------------------------------------------
# El mismo Client ID se usa en el navegador y en el servidor. Configura en Google
# Cloud Console los orígenes autorizados (por ejemplo https://tudominio.com).
GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ------------------------------------------------------------------------------
# 3. PAYPAL (SANDBOX POR DEFECTO / LIVE EN PRODUCCIÓN)
# ------------------------------------------------------------------------------
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_CURRENCY=USD
PAYPAL_API_BASE_URL=

# ------------------------------------------------------------------------------
# 4. GOOGLE DRIVE DATA VAULT & ACADEMIC ENGINE
# ------------------------------------------------------------------------------
# Carpeta raíz maestra compartida con la cuenta de servicio de Google Cloud.
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCAMBIAR\n-----END PRIVATE KEY-----\n"

# Carpetas secundarias opcionales (si se omiten, se organizan dentro de la raíz)
GOOGLE_DRIVE_PRIVATE_ADMIN_FOLDER_ID=
GOOGLE_DRIVE_STUDENT_REPORTS_FOLDER_ID=

# ------------------------------------------------------------------------------
# 5. MOODLE / MARIADB (INTEGRACIÓN LMS HISTÓRICA / EXTERNA)
# ------------------------------------------------------------------------------
MARIADB_ROOT_PASSWORD=CAMBIAR_EN_PRODUCCION
MARIADB_DATABASE=wisdom_moodle_db
MARIADB_USER=wisdom_user
MARIADB_PASSWORD=CAMBIAR_EN_PRODUCCION

MOODLE_PORT_HTTP=8080
MOODLE_PORT_HTTPS=8443
MOODLE_ADMIN_USER=admin
MOODLE_ADMIN_PASSWORD=CAMBIAR_EN_PRODUCCION
MOODLE_ADMIN_EMAIL=admin@wisdomacademy.edu.ec
MOODLE_REST_TOKEN=CAMBIAR_TOKEN_MOODLE
NEXT_PUBLIC_MOODLE_URL=http://localhost:8080
MOODLE_MOCK=0

# ------------------------------------------------------------------------------
# 6. PROVEEDORES DE IA (OPENMAIC)
# ------------------------------------------------------------------------------
GOOGLE_GEMINI_API_KEY=
OPENROUTER_FREE_API_KEY=
GROQ_API_KEY=
CEREBRAS_API_KEY=
MISTRAL_API_KEY=

# ------------------------------------------------------------------------------
# 7. VIDEOLLAMADAS Y AULAS VIRTUALES
# ------------------------------------------------------------------------------
JITSI_DOMAIN=meet.jit.si
BBB_SERVER_URL=
BBB_SHARED_SECRET=
GOOGLE_MEET_DEFAULT_URL=
ZOOM_DEFAULT_JOIN_URL=
MS_TEAMS_DEFAULT_URL=

# ------------------------------------------------------------------------------
# 8. RECURSOS EDUCATIVOS AUDIOVISUALES
# ------------------------------------------------------------------------------
YOUTUBE_API_KEY=
YOUTUBE_REGION_CODE=EC
EDUCATIONAL_VIDEO_CATALOG_PATH=
EDUCATIONAL_RESOURCES_DATA_DIR=.data/educational-resources
EDUCATIONAL_RESOURCES_PERSIST=true
EDUCATIONAL_RESOURCE_RATE_LIMIT_SALT=CAMBIAR_SAL_ALEATORIA
EDUCATIONAL_RESOURCES_ADMIN_TOKEN=

# ------------------------------------------------------------------------------
# 9. CORREO TRANSACCIONAL (RESEND HTTP API)
# ------------------------------------------------------------------------------
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_REPLY_TO=

# ------------------------------------------------------------------------------
# 10. PRUEBAS E2E (SOLO DESARROLLO / NUNCA EN PRODUCCIÓN)
# ------------------------------------------------------------------------------
WISDOM_E2E=0
WISDOM_E2E_PASSWORD=CAMBIAR_SOLO_PRUEBAS
WISDOM_E2E_ADMIN_PASSWORD=CAMBIAR_SOLO_PRUEBAS
WISDOM_ALLOW_INSECURE_COOKIE=0
